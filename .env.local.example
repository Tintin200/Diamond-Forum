# Ce fichier est un exemple pour .env.local
# COPIEZ ce fichier en .env.local et modifiez les valeurs
# NE JAMAIS COMMITER .env.local dans le contrôle de version !

# =============================================================================
# SÉCURITÉ
# =============================================================================

# Secret d'application - GÉNÉREZ un nouveau secret avec :
# php bin/console secrets:generate-keys
APP_SECRET=generer_un_nouveau_secret_ici

# =============================================================================
# BASE DE DONNÉES
# =============================================================================

# Pour MySQL/MariaDB (recommandé pour la production) :
# DATABASE_URL="mysql://utilisateur:mot_de_passe_fort@localhost:3306/baseball?serverVersion=8.0"

# Pour PostgreSQL :
# DATABASE_URL="postgresql://utilisateur:mot_de_passe_fort@localhost:5432/baseball?serverVersion=14"

# SQLite (pour le développement seulement - PAS pour la production !) :
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# =============================================================================
# API EXTERNE - Baseball
# =============================================================================

# Clé API pour API-Sports (https://www.api-sports.io/)
# Obtenez votre clé gratuite ou payante depuis leur site
BASEBALL_API_KEY=votre_clé_api_ici

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Domaine(s) autorisé(s) à accéder à votre API
# Adaptez cette regex selon votre environnement
# Exemple pour un domaine spécifique :
# CORS_ALLOW_ORIGIN='^https?://(votre-domaine\\.com|www\\.votre-domaine\\.com)$'
# Exemple pour localhost + un domaine :
# CORS_ALLOW_ORIGIN='^https?://(localhost|127\\.0\\.0\\.1|votre-domaine\\.com)(:[0-9]+)?$'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# =============================================================================
# MAILER (pour les emails de récupération de mot de passe, etc.)
# =============================================================================

# Exemple avec SendGrid :
# MAILER_DSN=sendgrid://API_KEY@default

# Exemple avec SMTP :
# MAILER_DSN=smtp://utilisateur:mot_de_passe@smtp.votre-hebergeur.com:587

# Pour le développement (ne pas utiliser en production) :
MAILER_DSN=null://null

# =============================================================================
# JWT (JSON Web Tokens)
# =============================================================================

# Chemins vers les clés JWT
# Ces fichiers sont générés automatiquement si ils n'existent pas
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Durée de vie des tokens JWT (en secondes)
# Par défaut : 1 heure pour l'authentification, 1 jour pour le refresh
JWT_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400

# =============================================================================
# CACHE
# =============================================================================

# Pour Redis (recommandé pour la production) :
# CACHE_DSN=redis://localhost:6379

# Pour APCu :
# CACHE_DSN=apcu://

# Par défaut (fichiers) :
# CACHE_DSN=file://%kernel.project_dir%/var/cache

# =============================================================================
# RATE LIMITING
# =============================================================================

# Limite de requêtes par IP (optionnel - les valeurs par défaut sont dans config/packages/rate_limiter.yaml)
# RATE_LIMIT_API=100
# RATE_LIMIT_AUTH=10

# =============================================================================
# AUTRES
# =============================================================================

# Environnement (dev, prod, test)
APP_ENV=dev

# Débogage (true pour le développement, false pour la production)
APP_DEBUG=true

# URI par défaut pour la génération d'URLs
DEFAULT_URI=http://localhost

# Répertoire partagé
APP_SHARE_DIR=var/share

# =============================================================================
# RAPPEL DE SÉCURITÉ
# =============================================================================
# 
# 1. NE JAMAIS commiter .env.local dans Git
#    Ajoutez .env.local à votre .gitignore
#
# 2. Utilisez toujours des mots de passe forts
#    - Pour la base de données
#    - Pour l'API externe
#    - Pour APP_SECRET
#
# 3. En production :
#    - APP_ENV=prod
#    - APP_DEBUG=false
#    - Utilisez HTTPS
#    - Configurez HSTS
#
# 4. Testez votre configuration :
#    - Exécutez : php bin/console lint:yaml
#    - Exécutez : php bin/console lint:twig
#    - Exécutez : composer audit
#
# =============================================================================
