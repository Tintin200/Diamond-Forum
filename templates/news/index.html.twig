{% extends 'base.html.twig' %}

{% block title %}Actualites - Diamond Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/forum.css') }}">
    <style>
        .df-room-card__image {
            width: 100%;
            height: 180px;
            border-radius: 8px;
            overflow: hidden;
            background: var(--gray-light);
        }
        .df-room-card__image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .df-room-card__icon-wrapper {
            width: 100%;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--gray-light);
            border-radius: 8px;
            overflow: hidden;
        }
        .df-room-card__icon-wrapper svg {
            width: 48px;
            height: 48px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="df-forum">
    <div class="df-forum__container">
        {# Brand #}
        <a href="{{ path('app_home') }}" class="df-forum__brand brand-link">
            <span class="df-forum__brand-badge">DF</span>
            <span class="df-forum__brand-name">DIAMOND FORUM</span>
        </a>

        {# Header #}
        <header class="df-forum__header">
            <span class="df-forum__eyebrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Actualites et Decryptages
            </span>
            <h1>Decouvrez les dernieres <span class="df-accent">actualites du baseball</span></h1>
            <p>Retrouvez les analyses, rumeurs de transfert et resumes de matchs analyses par nos experts.</p>
        </header>

        {# Articles a la une #}
        <section class="df-forum__section">
            <div class="df-forum__section-head">
                <h2>A la Une</h2>
                <a href="{{ path('app_article_new') }}" class="df-forum__cta">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Publier un Article
                </a>
            </div>

            <div class="df-forum__rooms">
                {% if headlineArticles is not empty %}
                    {% for article in headlineArticles %}
                        <a href="{{ path('app_article_show', {id: article.id}) }}" class="df-room-card">
                            {% if article.image %}
                                <div class="df-room-card__image">
                                    <img src="{{ article.image }}" alt="{{ article.sujet }}" />
                                </div>
                            {% else %}
                                <div class="df-room-card__icon-wrapper" style="background:rgba(255,242,0,0.1);">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#FFF200" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                                        <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                                        <path d="M4 22h16"/>
                                        <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                                        <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                                        <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                                    </svg>
                                </div>
                            {% endif %}
                            <h3>{{ article.sujet }}</h3>
                            <p>{{ article.contenu|slice(0, 100) }}...</p>
                            <div class="df-room-card__footer">
                                <span class="df-room-card__count">{{ article.articleLikes|length }} likes</span>
                                <span class="df-room-card__explore">
                                    Lire l'article
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </span>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </section>

        {# Articles de la communaute #}
        <section class="df-forum__section">
            <div class="df-forum__section-head">
                <h2>Publications de la Communaute</h2>
            </div>

            <div class="df-forum__rooms">
                {% if communityArticles is not empty %}
                    {% for article in communityArticles %}
                        <a href="{{ path('app_article_show', {id: article.id}) }}" class="df-room-card">
                            {% if article.image %}
                                <div class="df-room-card__image">
                                    <img src="{{ article.image }}" alt="{{ article.sujet }}" />
                                </div>
                            {% else %}
                                <div class="df-room-card__icon-wrapper" style="background:rgba(16,185,129,0.1);">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m17 2 4 4-4 4"/>
                                        <path d="M3 11v-1a4 4 0 0 1 4-4h14"/>
                                        <path d="m7 22-4-4 4-4"/>
                                        <path d="M21 13v1a4 4 0 0 1-4 4H3"/>
                                    </svg>
                                </div>
                            {% endif %}
                            <h3>{{ article.sujet }}</h3>
                            <p>{{ article.contenu|slice(0, 100) }}...</p>
                            <div class="df-room-card__footer">
                                <span class="df-room-card__count">{{ article.articleLikes|length }} likes</span>
                                <span class="df-room-card__explore">
                                    Lire l'article
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </span>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </section>

        {# Categories Populaires #}
        <section class="df-forum__section">
            <div class="df-forum__section-head">
                <h2>Categories Populaires</h2>
            </div>

            <div class="df-forum__rooms">
                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(255,242,0,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#FFF200" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                            <path d="M4 22h16"/>
                            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                        </svg>
                    </div>
                    <h3>Analyses de Match</h3>
                    <p>Decryptage tactique des lancers et des choix strategiques des managers de la MLB.</p>
                </div>

                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(16,185,129,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m17 2 4 4-4 4"/>
                            <path d="M3 11v-1a4 4 0 0 1 4-4h14"/>
                            <path d="m7 22-4-4 4-4"/>
                            <path d="M21 13v1a4 4 0 0 1-4 4H3"/>
                        </svg>
                    </div>
                    <h3>Rumeurs et Transferts</h3>
                    <p>Suivez les coulisses des negociations dagents et les futurs mouvements des joueurs vedettes.</p>
                </div>

                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(239,68,68,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="12" y1="20" x2="12" y2="10"/>
                            <line x1="18" y1="20" x2="18" y2="4"/>
                            <line x1="6" y1="20" x2="6" y2="16"/>
                        </svg>
                    </div>
                    <h3>Sabermetrics et Stats</h3>
                    <p>Pour les amateurs de chiffres : analyses poussees des statistiques de WHIP, ERA et WAR.</p>
                </div>

                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(255,242,0,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#FFF200" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4" y="2" width="16" height="20" rx="2"/>
                            <path d="M9 22v-4h6v4"/>
                            <path d="M8 6h.01"/>
                            <path d="M16 6h.01"/>
                            <path d="M12 6h.01"/>
                            <path d="M12 10h.01"/>
                            <path d="M12 14h.01"/>
                            <path d="M16 10h.01"/>
                            <path d="M16 14h.01"/>
                            <path d="M8 10h.01"/>
                            <path d="M8 14h.01"/>
                        </svg>
                    </div>
                    <h3>Focus Equipes</h3>
                    <p>Analyses approfondies sur letat de forme et les finances des 30 franchises de la MLB.</p>
                </div>

                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(16,185,129,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                        </svg>
                    </div>
                    <h3>Legendes du Baseball</h3>
                    <p>Redecouvrez les carrieres exceptionnelles des iconnes qui ont marque lhistoire du jeu.</p>
                </div>

                <div class="df-room-card">
                    <div class="df-room-card__icon-wrapper" style="background:rgba(239,68,68,0.1);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                            <path d="M2 12h20"/>
                        </svg>
                    </div>
                    <h3>Stades Historiques</h3>
                    <p>Un voyage a travers les parcs et terrains legendaires des Etats-Unis et du monde entier.</p>
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}
