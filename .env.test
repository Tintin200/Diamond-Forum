# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_ENV=test
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://app:!ChangeMe!@localhost:5432/diamond_test?serverVersion=16&charset=utf8"
DEFAULT_URI=http://localhost

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer
MAILER_DSN=null://null

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Baseball API - clés dummy pour les tests (les vrais tests utilisent des mocks)
BASEBALL_API_URL=https://v1.baseball.api-sports.io/
BASEBALL_API_KEY=dummy_test_key_for_github_actions

# JWT - clés générées dynamiquement dans le workflow
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dummy_passphrase_for_tests

